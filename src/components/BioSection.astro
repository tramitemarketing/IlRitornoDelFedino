---
import { siteConfig } from '../site.config';
const { bio, professor, contact } = siteConfig;

const socials = [
  { label: 'Email', href: contact.email ? `mailto:${contact.email}` : '', value: contact.email },
  { label: 'Instagram', href: contact.instagram, value: contact.instagram },
  { label: 'YouTube', href: contact.youtube, value: contact.youtube },
  { label: 'LinkedIn', href: contact.linkedin, value: contact.linkedin },
].filter((s) => s.value);
---

<section class="bio section" id="bio">
  <div class="container bio__inner reveal">
    <div class="bio__meta">
      <p class="eyebrow">{bio.heading}</p>
      <h2 class="bio__name">{professor.name}</h2>
      <p class="bio__field">{professor.field}</p>
    </div>
    <div class="bio__text">
      {bio.paragraphs.map((p) => <p>{p}</p>)}

      {socials.length > 0 && (
        <ul class="bio__socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <footer class="footer container">
    <span>© {new Date().getFullYear()} {professor.name}</span>
    <span class="footer__credit">{siteConfig.siteName}</span>
  </footer>
</section>

<style>
  .bio {
    background: var(--bg);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }
  .bio__inner {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  @media (max-width: 720px) {
    .bio__inner { grid-template-columns: 1fr; }
  }

  .bio__name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
  }
  .bio__field {
    color: var(--text-dim);
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }

  .bio__text p {
    color: var(--text-muted);
    margin-bottom: 1.1rem;
    font-size: 1.05rem;
  }

  .bio__socials {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .bio__socials a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.9rem;
    color: var(--text);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .bio__socials a:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .footer__credit { font-family: var(--font-display); }
</style>
