---
import { siteConfig } from '../site.config';
const { bio, professor, contact } = siteConfig;

const socials = [
  { label: 'Instagram', href: contact.instagram, value: contact.instagram },
  { label: 'YouTube', href: contact.youtube, value: contact.youtube },
  { label: 'Email', href: contact.email ? `mailto:${contact.email}` : '', value: contact.email },
  { label: 'LinkedIn', href: contact.linkedin, value: contact.linkedin },
].filter((s) => s.value);
---

<section class="bio section" id="bio">
  <div class="container">
    <header class="bio__head reveal">
      <p class="eyebrow">{bio.eyebrow}</p>
      <h2 class="bio__name gradient-text">{bio.name}</h2>
    </header>

    <div class="bio__body">
      {bio.sections.map((sec) => (
        <article class="chapter reveal">
          <h3 class="chapter__title">{sec.heading}</h3>
          {sec.quote && <blockquote class="chapter__quote">{sec.quote}</blockquote>}
          {sec.paragraphs.map((p) => <p class="chapter__p">{p}</p>)}
          {sec.items && (
            <ul class="chapter__list">
              {sec.items.map((it) => (
                <li>
                  <strong>{it.term}.</strong> {it.desc}
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    {socials.length > 0 && (
      <div class="bio__contact reveal">
        <p class="eyebrow">Contatti</p>
        <ul class="bio__socials">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <footer class="footer container">
    <span>© {new Date().getFullYear()} {professor.name}</span>
    <span class="footer__credit">{siteConfig.siteName}</span>
  </footer>
</section>

<style>
  .bio {
    background: var(--bg);
    border-top: 1px solid rgba(63, 154, 166, 0.1);
  }

  .bio__head {
    text-align: center;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .bio__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .bio__lead {
    max-width: 46rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
  }
  .bio__lead p {
    color: var(--text);
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }
  .bio__lead p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: 3.4em;
    float: left;
    line-height: 0.8;
    padding: 0.05em 0.12em 0 0;
    color: var(--teal-bright);
  }

  .bio__body {
    max-width: 44rem;
    margin: 0 auto;
  }
  .chapter {
    padding-block: clamp(1.6rem, 4vw, 2.4rem);
    border-top: 1px solid rgba(63, 154, 166, 0.12);
  }
  .chapter__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.4vw, 1.7rem);
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .chapter__p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1.1rem;
  }
  .chapter__quote {
    margin: 0 0 1.4rem;
    padding: 0.4rem 0 0.4rem 1.4rem;
    border-left: 2px solid var(--teal-bright);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    line-height: 1.35;
    color: var(--text);
    font-style: italic;
  }
  .chapter__list {
    list-style: none;
    padding: 0;
    margin: 0.4rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .chapter__list li {
    color: var(--text-muted);
    line-height: 1.7;
    padding: 1rem 1.2rem;
    background: var(--surface);
    border: 1px solid rgba(63, 154, 166, 0.12);
    border-radius: var(--radius-sm);
  }
  .chapter__list strong { color: var(--teal-bright); }

  .bio__contact {
    max-width: 44rem;
    margin: clamp(2.5rem, 6vw, 4rem) auto 0;
    text-align: center;
  }
  .bio__socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .bio__socials a {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(63, 154, 166, 0.3);
    font-size: 0.92rem;
    color: var(--text);
    transition: border-color 0.3s var(--ease), color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .bio__socials a:hover {
    border-color: var(--teal-bright);
    color: var(--teal-bright);
    background: rgba(63, 154, 166, 0.08);
  }

  .footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid rgba(63, 154, 166, 0.12);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
  .footer__credit { font-family: var(--font-display); }
</style>
