---
import { siteConfig } from '../site.config';
const { intro } = siteConfig;
---

<section class="intro" id="home">
  <!-- Auto (render statico, sfumata nel nero) -->
  <img
    class="intro__car"
    src={intro.image}
    alt=""
    aria-hidden="true"
    decoding="async"
    fetchpriority="high"
  />

  <!-- Titolo, spostato verso l'alto -->
  <div class="intro__title">
    <h1 class="intro__name gradient-text">{intro.titleScreen}</h1>
    {intro.titleSub && <p class="intro__sub">{intro.titleSub}</p>}
  </div>

  <!-- Velo nero per la dissolvenza d'ingresso -->
  <div class="intro__fade" id="intro-fade"></div>
</section>

<style>
  .intro {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #000;
  }

  .intro__car {
    position: absolute;
    left: 50%;
    top: 58%;
    transform: translate(-50%, -50%);
    width: min(94vw, 1080px);
    max-height: 78vh;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    /* Sfuma i bordi dell'auto nel nero dello sfondo */
    -webkit-mask-image: radial-gradient(
      72% 70% at 50% 52%,
      #000 38%,
      rgba(0, 0, 0, 0.55) 70%,
      transparent 100%
    );
    mask-image: radial-gradient(
      72% 70% at 50% 52%,
      #000 38%,
      rgba(0, 0, 0, 0.55) 70%,
      transparent 100%
    );
    filter: brightness(0.96) contrast(1.04);
  }

  /* Alone scuro che chiude l'auto nel fondo */
  .intro::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      80% 75% at 50% 55%,
      transparent 45%,
      rgba(0, 0, 0, 0.55) 80%,
      #000 100%
    );
  }

  .intro__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 16%;
    z-index: 2;
    text-align: center;
    padding: 0 1.5rem;
    pointer-events: none;
  }
  .intro__name {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-size: clamp(2.4rem, 9.5vw, 7rem);
    filter: drop-shadow(0 0 50px rgba(29, 107, 118, 0.35));
  }
  .intro__sub {
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: clamp(0.7rem, 2vw, 0.9rem);
  }

  /* Velo nero d'ingresso: parte coprente e svanisce */
  .intro__fade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #000;
    opacity: 1;
    pointer-events: none;
    animation: intro-fade 1.3s ease forwards;
  }
  @keyframes intro-fade {
    to { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__fade { animation: none; opacity: 0; }
  }

  @media (max-width: 560px) {
    .intro__car { top: 60%; width: 112vw; }
    .intro__title { top: 13%; }
  }
</style>

<script>
  // Al reload riparti sempre dall'alto
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);
</script>
