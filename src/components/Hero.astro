---
import { siteConfig } from '../site.config';
const { intro } = siteConfig;
const hasVideo = intro.videoSrc.trim() !== '';
---

<section class="intro" id="home">
  {hasVideo ? (
    <video
      id="intro-video"
      class="intro__media"
      muted
      playsinline
      preload="auto"
      poster={intro.poster || undefined}
      aria-hidden="true"
      style={intro.filter ? `filter: ${intro.filter}` : undefined}
    >
      {intro.videoWebm && <source src={intro.videoWebm} type="video/webm" />}
      <source src={intro.videoSrc} type="video/mp4" />
    </video>
  ) : (
    <canvas id="alley-canvas" class="intro__media" aria-hidden="true"></canvas>
  )}

  {hasVideo && intro.gradeColor && (
    <div
      class="intro__grade"
      style={`background:${intro.gradeColor}; opacity:${intro.gradeOpacity}`}
    ></div>
  )}

  <!-- Velo nero: schermata iniziale + dissolvenza finale -->
  <div class="intro__black" id="intro-black"></div>

  <!-- Titolo sullo schermo nero iniziale -->
  <div class="intro__title" id="intro-title">
    <h1 class="intro__name gradient-text">{intro.titleScreen}</h1>
    {intro.titleSub && <p class="intro__sub">{intro.titleSub}</p>}
  </div>

  <!-- Tasto play (visioni successive + fallback autoplay) -->
  <button class="intro__play" id="intro-play" type="button" aria-label="Riproduci" hidden>
    <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
  </button>

  <!-- Tasto audio -->
  <button class="intro__audio" id="intro-audio" type="button" aria-pressed="false" aria-label="Attiva audio" hidden>
    <svg class="ico ico--off" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3l2.5 2.5-1.5 1.5L15 13.5 12.5 16 11 14.5 13.5 12 11 9.5 12.5 8 15 10.5 17.5 8 19 9.5 16.5 12z"/>
    </svg>
    <svg class="ico ico--on" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3zm13-1.5a5 5 0 010 9V14a3 3 0 000-4.5V7.5zm0-3.5a8.5 8.5 0 010 16.5v-2.1a6.4 6.4 0 000-12.3V4z"/>
    </svg>
  </button>
</section>

<style>
  .intro {
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: #000;
  }
  .intro__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .intro__grade {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .intro__grade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 50% 45%, transparent 40%, rgba(0, 0, 0, 0.6));
  }

  .intro__black {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #000;
    opacity: 1; /* parte nero */
    transition: opacity 0.7s ease;
    pointer-events: none;
  }

  .intro__title {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    text-align: center;
    padding: 1.5rem;
    opacity: 1; /* titolo visibile sul nero iniziale */
    transition: opacity 0.7s ease;
    pointer-events: none;
  }
  .intro__name {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    font-size: clamp(2.6rem, 11vw, 8rem);
    filter: drop-shadow(0 0 50px rgba(29, 107, 118, 0.35));
  }
  .intro__sub {
    margin-top: 1rem;
    color: var(--text-muted);
    font-family: var(--font-display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: clamp(0.7rem, 2vw, 0.9rem);
  }

  /* Tasto audio (in basso a destra) */
  .intro__audio {
    position: absolute;
    right: 1.3rem;
    bottom: 1.3rem;
    z-index: 4;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    color: var(--text-muted);
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .intro__audio:hover { color: var(--text); border-color: var(--teal-bright); }
  .intro__audio .ico--on { display: none; }
  .intro__audio[aria-pressed='true'] { color: var(--teal-bright); border-color: var(--teal-bright); }
  .intro__audio[aria-pressed='true'] .ico--off { display: none; }
  .intro__audio[aria-pressed='true'] .ico--on { display: block; }

  /* Tasto play (solo visioni successive, discreto) */
  .intro__play {
    position: absolute;
    inset: 0;
    margin: auto;
    z-index: 4;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 1px solid rgba(211, 154, 58, 0.5);
    color: var(--text);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
    display: grid;
    place-items: center;
    padding-left: 4px;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .intro__play svg { width: 24px; height: 24px; }
  .intro__play:hover {
    transform: scale(1.08);
    border-color: var(--ember);
    box-shadow: var(--glow);
  }
</style>

<script>
  // ===========================================================
  // HOME — Intro: schermo nero col titolo (3s) -> video.
  // 1a visita: autostart MUTO (regole browser) + tasto audio,
  // scroll bloccato fino a fine video -> va alla sezione podcast.
  // Visioni successive: tasto play (audio acceso al clic).
  // Reload: sempre in cima.
  // ===========================================================
  const section = document.querySelector<HTMLElement>('.intro');
  const black = document.getElementById('intro-black');
  const title = document.getElementById('intro-title');
  const playBtn = document.getElementById('intro-play') as HTMLButtonElement | null;
  const audioBtn = document.getElementById('intro-audio') as HTMLButtonElement | null;
  const video = document.getElementById('intro-video') as HTMLVideoElement | null;
  const canvas = document.getElementById('alley-canvas') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Al reload riparti sempre dall'alto
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  window.scrollTo(0, 0);

  const TITLE_MS = 3000;     // schermata nera col titolo prima dell'autostart
  const END_FADE_S = 0.8;    // secondi finali di dissolvenza al nero
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  if (section) {
    let running = false;
    let completed = false;
    let faded = false;
    let lockedRun = false;
    let token = 0;

    const setBlack = (a: number) => black && (black.style.opacity = String(a));
    const setTitle = (a: number) => title && (title.style.opacity = String(a));
    const show = (el: HTMLElement | null, on: boolean) => el && (el.hidden = !on);

    function lockScroll(on: boolean) {
      const v = on ? 'hidden' : '';
      document.documentElement.style.overflow = v;
      document.body.style.overflow = v;
    }

    function syncAudioBtn() {
      if (!video || !audioBtn) return;
      const on = !video.muted;
      audioBtn.setAttribute('aria-pressed', String(on));
      audioBtn.setAttribute('aria-label', on ? 'Disattiva audio' : 'Attiva audio');
    }

    function finish() {
      token++;                 // invalida eventuali sequenze in sospeso
      running = false;
      completed = true;
      faded = true;
      setTitle(0);
      setBlack(1);
      show(playBtn, false);
      show(audioBtn, false);
      lockScroll(false);
      if (video) try { video.pause(); } catch {}
      if (lockedRun) {
        document.getElementById('podcast')?.scrollIntoView({ behavior: 'smooth' });
      }
      lockedRun = false;
    }

    // Avvia la riproduzione (con o senza audio) rivelando il video
    async function startPlayback(withAudio: boolean) {
      setTitle(0);
      setBlack(0);
      show(playBtn, false);
      show(audioBtn, true);
      if (!video) return;
      video.muted = !withAudio;
      syncAudioBtn();
      try {
        await video.play();
      } catch {
        // riproduzione rifiutata
        video.muted = true;
        syncAudioBtn();
        if (lockedRun) {
          // prima visita: nessun tasto play, sblocca soltanto
          lockScroll(false);
        } else {
          // visione successiva: riproponi il tasto play
          show(playBtn, true);
        }
      }
    }

    // lock = blocca lo scroll; autostart = parte da solo (muto) dopo i 3s,
    // altrimenti mostra il tasto play (visioni successive, audio al clic).
    async function run(opts: { lock: boolean; autostart: boolean }) {
      if (running) return;
      running = true;
      lockedRun = opts.lock;
      completed = false;
      faded = false;
      const my = ++token;

      setBlack(1);
      setTitle(1);
      show(playBtn, false);
      show(audioBtn, false);
      if (opts.lock) lockScroll(true);
      if (video) { try { video.pause(); video.currentTime = 0; } catch {} }

      if (opts.autostart) {
        await wait(TITLE_MS);
        if (my !== token) return;
        startPlayback(false); // autostart muto (regole browser)
      } else {
        // visione successiva: tasto play sullo schermo nero (audio al clic)
        show(playBtn, true);
      }
    }

    // --- Eventi video ---
    if (video) {
      video.addEventListener('timeupdate', () => {
        const d = video.duration || 0;
        if (d > 0 && !faded && video.currentTime >= d - END_FADE_S) {
          faded = true;
          setBlack(1); // dissolvenza al nero (blend col fondo)
        }
      });
      video.addEventListener('ended', finish);
    }

    // Tasto play: avvia con audio acceso (è un clic dell'utente)
    playBtn?.addEventListener('click', () => startPlayback(true));

    // Tasto audio: attiva/disattiva il sonoro
    audioBtn?.addEventListener('click', () => {
      if (!video) return;
      video.muted = !video.muted;
      syncAudioBtn();
    });

    // --- Riparte tornando in cima (con tasto play, non in automatico) ---
    const io = new IntersectionObserver(
      (entries) => {
        const e = entries[0];
        if (e.isIntersecting && e.intersectionRatio >= 0.9 && completed && !running) {
          run({ lock: false, autostart: false });
        }
      },
      { threshold: [0, 0.9, 1] },
    );
    io.observe(section);

    // --- Avvio (prima visita: autostart muto dopo 3s, scroll bloccato) ---
    if (reduce) {
      setBlack(0);
      setTitle(0);
      show(playBtn, true);
      lockScroll(false);
    } else if (video) {
      run({ lock: true, autostart: true });
    } else if (canvas) {
      setupCanvas(canvas);
    }

    // ---------------- CANVAS (fallback senza video) ----------------
    function setupCanvas(cv: HTMLCanvasElement) {
      const ctx = cv.getContext('2d')!;
      let w = 0, h = 0, dpr = 1;
      const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const smooth = (e0: number, e1: number, x: number) => {
        const t = clamp((x - e0) / (e1 - e0));
        return t * t * (3 - 2 * t);
      };
      const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = cv.clientWidth; h = cv.clientHeight;
        cv.width = Math.floor(w * dpr); cv.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      function roundRect(x: number, y: number, ww: number, hh: number, r: number) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + ww, y, x + ww, y + hh, r);
        ctx.arcTo(x + ww, y + hh, x, y + hh, r);
        ctx.arcTo(x, y + hh, x, y, r);
        ctx.arcTo(x, y, x + ww, y, r);
        ctx.closePath();
      }
      function drawWheel(x: number, y: number, r: number, ang: number) {
        ctx.save(); ctx.translate(x, y);
        ctx.fillStyle = '#020405';
        ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI * 2); ctx.fill();
        ctx.rotate(ang);
        ctx.strokeStyle = 'rgba(63,154,166,0.5)';
        ctx.lineWidth = Math.max(1, r * 0.12);
        for (let i = 0; i < 4; i++) {
          ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(0, -r * 0.7); ctx.stroke();
          ctx.rotate(Math.PI / 2);
        }
        ctx.restore();
      }
      function drawCar(cx: number, cy: number, s: number, ang: number, light: number, brake: number) {
        const L = w * 0.22 * s, H = L * 0.30, wr = H * 0.42;
        ctx.save(); ctx.translate(cx, cy);
        const sh = ctx.createRadialGradient(0, H * 0.95, 0, 0, H * 0.95, L * 0.62);
        sh.addColorStop(0, 'rgba(0,0,0,0.6)'); sh.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = sh;
        ctx.beginPath(); ctx.ellipse(0, H * 0.98, L * 0.62, H * 0.28, 0, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#04090b';
        roundRect(-L / 2, -H * 0.2, L, H, H * 0.42); ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-L * 0.26, -H * 0.2); ctx.lineTo(-L * 0.14, -H * 0.78);
        ctx.lineTo(L * 0.16, -H * 0.78); ctx.lineTo(L * 0.30, -H * 0.2);
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = 'rgba(63,154,166,0.16)';
        ctx.beginPath();
        ctx.moveTo(-L * 0.20, -H * 0.24); ctx.lineTo(-L * 0.10, -H * 0.70);
        ctx.lineTo(L * 0.12, -H * 0.70); ctx.lineTo(L * 0.24, -H * 0.24);
        ctx.closePath(); ctx.fill();
        drawWheel(-L * 0.30, H * 0.78, wr, ang);
        drawWheel(L * 0.30, H * 0.78, wr, ang);
        const hx = -L * 0.5, hy = H * 0.18;
        if (light > 0.01) {
          ctx.fillStyle = `rgba(190,236,240,${0.9 * light})`;
          ctx.beginPath(); ctx.arc(hx, hy, H * 0.12, 0, Math.PI * 2); ctx.fill();
        }
        ctx.restore();
        if (light > 0.01) {
          const bx = cx + hx, by = cy + hy;
          const beam = ctx.createLinearGradient(bx, by, bx - L * 1.6, by + H * 1.2);
          beam.addColorStop(0, `rgba(170,230,235,${0.28 * light})`);
          beam.addColorStop(1, 'rgba(170,230,235,0)');
          ctx.fillStyle = beam;
          ctx.beginPath();
          ctx.moveTo(bx, by - H * 0.1); ctx.lineTo(bx - L * 1.7, by + H * 1.5);
          ctx.lineTo(bx - L * 1.7, by + H * 3.2); ctx.lineTo(bx, by + H * 0.5);
          ctx.closePath(); ctx.fill();
        }
      }
      function draw(sp: number, time: number) {
        ctx.clearRect(0, 0, w, h);
        const VPx = w * 0.5, VPy = h * 0.42, groundY = h * 0.99;
        const flick = 0.85 + Math.sin(time * 0.004) * 0.06;
        const sky = ctx.createLinearGradient(0, 0, 0, h);
        sky.addColorStop(0, '#02080a'); sky.addColorStop(0.6, '#010405'); sky.addColorStop(1, '#000');
        ctx.fillStyle = sky; ctx.fillRect(0, 0, w, h);
        const nearL = w * 0.06, nearR = w * 0.94;
        const farL = VPx - w * 0.05, farR = VPx + w * 0.05, farY = VPy + h * 0.02;
        const road = ctx.createLinearGradient(0, farY, 0, groundY);
        road.addColorStop(0, '#031a1e'); road.addColorStop(1, '#000');
        ctx.fillStyle = road;
        ctx.beginPath();
        ctx.moveTo(nearL, groundY); ctx.lineTo(nearR, groundY);
        ctx.lineTo(farR, farY); ctx.lineTo(farL, farY); ctx.closePath(); ctx.fill();
        const lampX = w * 0.2, lampTop = h * 0.18, curbY = h * 0.7;
        const lg = ctx.createRadialGradient(lampX + w * 0.05, lampTop, 0, lampX + w * 0.05, lampTop, w * 0.04);
        lg.addColorStop(0, `rgba(150,230,235,${0.5 * flick})`); lg.addColorStop(1, 'rgba(150,230,235,0)');
        ctx.fillStyle = lg; ctx.fillRect(0, 0, w, h);
        const drive = easeOutCubic(clamp(sp / 0.82));
        const carX = lerp(w * 1.25, w * 0.4, drive);
        const dist = (w * 1.25 - carX) / (h * 0.05);
        const light = 1 - smooth(0.8, 1, sp);
        drawCar(carX, h * 0.82, lerp(1.05, 0.92, drive), -dist, light, 0);
        const vig = ctx.createRadialGradient(w / 2, h / 2, h * 0.25, w / 2, h / 2, h * 0.85);
        vig.addColorStop(0, 'rgba(0,0,0,0)'); vig.addColorStop(1, 'rgba(0,0,0,0.75)');
        ctx.fillStyle = vig; ctx.fillRect(0, 0, w, h);
      }
      window.addEventListener('resize', resize);
      resize();
      // titolo poi scena in loop (ping-pong)
      wait(TITLE_MS).then(() => { setTitle(0); setBlack(0); lockScroll(false); });
      let raf = 0;
      function loop() {
        const t = performance.now();
        const cyc = (t / 9000) % 2;
        draw(cyc < 1 ? cyc : 2 - cyc, t);
        raf = requestAnimationFrame(loop);
      }
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else loop();
      });
      loop();
    }
  }
</script>
