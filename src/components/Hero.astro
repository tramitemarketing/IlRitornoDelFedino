---
import { siteConfig } from '../site.config';
const { professor } = siteConfig;
---

<section class="hero" id="home">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__content container">
    <p class="hero__eyebrow">{siteConfig.siteName}</p>
    <h1 class="hero__title">
      <span class="gradient-text">{professor.name}</span>
    </h1>
    <p class="hero__tagline">{professor.tagline}</p>

    <a class="hero__cta" href="#podcast">
      <span class="hero__cta-dot"></span>
      Ascolta il podcast
    </a>
  </div>

  <a class="hero__scroll" href="#podcast" aria-label="Scorri">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% -10%, rgba(108, 92, 231, 0.18), transparent 60%),
      var(--bg);
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* Velo per leggibilità del testo */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(60% 50% at 50% 55%, rgba(7, 8, 13, 0.55), transparent 75%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero__eyebrow {
    font-family: var(--font-display);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    font-size: clamp(3rem, 13vw, 9rem);
    letter-spacing: -0.02em;
    filter: drop-shadow(0 0 50px rgba(108, 92, 231, 0.35));
  }

  .hero__tagline {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 3vw, 1.4rem);
    color: var(--text-muted);
    max-width: 36ch;
    margin-inline: auto;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .hero__cta:hover {
    transform: translateY(-3px);
    border-color: rgba(108, 92, 231, 0.6);
    box-shadow: var(--glow);
  }
  .hero__cta-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: 0 0 12px var(--accent-2);
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: 0.5; }
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 26px;
    height: 42px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    display: grid;
    place-items: start center;
    padding-top: 7px;
  }
  .hero__scroll span {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent-2);
    animation: scrolldot 1.8s infinite;
  }
  @keyframes scrolldot {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(14px); opacity: 0; }
    100% { opacity: 0; }
  }
</style>

<script>
  // =========================================================
  // ANIMAZIONE HERO — particelle + onde sonore generative
  // Canvas 2D, zero dipendenze, interattiva col mouse.
  // =========================================================
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d', { alpha: true })!;
    let w = 0, h = 0, dpr = 1;
    let raf = 0;
    let t = 0;

    const COLORS = ['#6c5ce7', '#00e0c6', '#ff5d8f'];
    type P = { x: number; y: number; vx: number; vy: number; r: number; c: string };
    let particles: P[] = [];

    const mouse = { x: -9999, y: -9999, active: false };

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initParticles();
    }

    function initParticles() {
      const count = Math.min(120, Math.floor((w * h) / 12000));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.35,
        vy: (Math.random() - 0.5) * 0.35,
        r: Math.random() * 1.8 + 0.6,
        c: COLORS[(Math.random() * COLORS.length) | 0],
      }));
    }

    // Onde sonore: più sinusoidi sovrapposte che pulsano
    function drawWaves() {
      const layers = [
        { amp: 38, freq: 0.006, speed: 0.018, color: 'rgba(108,92,231,0.30)', off: 0 },
        { amp: 26, freq: 0.010, speed: 0.026, color: 'rgba(0,224,198,0.28)', off: 2 },
        { amp: 18, freq: 0.016, speed: 0.034, color: 'rgba(255,93,143,0.22)', off: 4 },
      ];
      const baseY = h * 0.62;
      for (const L of layers) {
        ctx.beginPath();
        for (let x = 0; x <= w; x += 6) {
          const pulse = 1 + 0.4 * Math.sin(t * 0.04 + x * 0.002);
          const y =
            baseY +
            Math.sin(x * L.freq + t * L.speed + L.off) * L.amp * pulse +
            Math.sin(x * L.freq * 2.3 + t * L.speed * 1.4) * (L.amp * 0.35);
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = L.color;
        ctx.lineWidth = 2;
        ctx.shadowBlur = 18;
        ctx.shadowColor = L.color;
        ctx.stroke();
      }
      ctx.shadowBlur = 0;
    }

    function drawParticles() {
      // linee di connessione (constellation)
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 130 * 130) {
            const alpha = (1 - Math.sqrt(d2) / 130) * 0.5;
            ctx.strokeStyle = `rgba(154,160,180,${alpha})`;
            ctx.lineWidth = 0.6;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      // particelle
      for (const p of particles) {
        // interazione mouse: repulsione morbida
        if (mouse.active) {
          const dx = p.x - mouse.x, dy = p.y - mouse.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 140 * 140 && d2 > 0.01) {
            const f = (1 - Math.sqrt(d2) / 140) * 0.8;
            const d = Math.sqrt(d2);
            p.vx += (dx / d) * f * 0.4;
            p.vy += (dy / d) * f * 0.4;
          }
        }
        p.x += p.vx;
        p.y += p.vy;
        // attrito + clamp velocità
        p.vx *= 0.98; p.vy *= 0.98;
        // wrap ai bordi
        if (p.x < -10) p.x = w + 10; else if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10; else if (p.y > h + 10) p.y = -10;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = p.c;
        ctx.shadowBlur = 10;
        ctx.shadowColor = p.c;
        ctx.fill();
      }
      ctx.shadowBlur = 0;
    }

    function loop() {
      ctx.clearRect(0, 0, w, h);
      drawWaves();
      drawParticles();
      t += 1;
      raf = requestAnimationFrame(loop);
    }

    // eventi
    window.addEventListener('resize', resize);
    window.addEventListener('mousemove', (e) => {
      const rect = canvas!.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });
    window.addEventListener('mouseleave', () => (mouse.active = false));

    // pausa quando non visibile (risparmio batteria)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else loop();
    });

    resize();
    loop();
  }
</script>
