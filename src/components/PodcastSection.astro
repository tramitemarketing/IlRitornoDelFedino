---
import { siteConfig } from '../site.config';
import {
  getShowEpisodes,
  formatDuration,
  formatDate,
  type Episode,
  type FetchStatus,
} from '../lib/spotify';

const { podcast, contact } = siteConfig;
const layout = podcast.layout;

// 1) griglia via API solo in layout 'grid'
let episodes: Episode[] = [];
let status: FetchStatus = 'empty';
let detail = '';
if (layout === 'grid' && podcast.autoFetch) {
  const res = await getShowEpisodes(podcast.showId, podcast.market, podcast.maxEpisodes);
  episodes = res.episodes;
  status = res.status;
  detail = res.detail ?? '';
}

// Messaggio diagnostico mostrato in pagina quando la griglia non c'è
const diagMap: Record<FetchStatus, string> = {
  ok: '',
  empty: 'Nessun episodio trovato per questo show (controlla showId e market).',
  'no-creds':
    'Credenziali Spotify non rilevate durante la pubblicazione: aggiungi SPOTIFY_CLIENT_ID e SPOTIFY_CLIENT_SECRET nelle Environment Variables (Production) e fai un nuovo deploy.',
  'token-error':
    'Spotify ha rifiutato le credenziali (token): ricontrolla Client ID e Client Secret.',
  'api-error':
    "Spotify ha bloccato sia l'API sia la lettura dell'embed per la lista episodi. Incolla i link degli episodi in site.config.ts → podcast.episodes.",
  'network-error': 'Errore di rete verso Spotify durante la pubblicazione.',
};
const diagMessage = diagMap[status]
  ? diagMap[status] + (detail ? ` [${detail}]` : '')
  : '';

// 2) fallback: episodi inseriti a mano nel config (solo layout 'grid').
// Accetta sia l'ID puro sia il link completo open.spotify.com/episode/...
if (layout === 'grid' && episodes.length === 0 && podcast.episodes.length > 0) {
  episodes = podcast.episodes.map((e) => {
    const id = e.id.match(/episode\/([A-Za-z0-9]+)/)?.[1] ?? e.id;
    return {
      id,
      name: e.title ?? 'Episodio',
      description: '',
      releaseDate: '',
      durationMs: 0,
      image: null,
      url: `https://open.spotify.com/episode/${id}`,
    };
  });
}

const hasShow = podcast.showId.trim() !== '';
const showGrid = layout === 'grid' && episodes.length > 0;
const showPlayer = layout === 'show' && hasShow;
// layout 'grid' senza episodi: stato vuoto pulito (niente player di ripiego)
const noEpisodes = layout === 'grid' && episodes.length === 0;
---

<section class="podcast section" id="podcast">
  <div class="container">
    <header class="podcast__head reveal">
      {podcast.eyebrow && <p class="eyebrow">{podcast.eyebrow}</p>}
      <h2 class="podcast__title gradient-text">{podcast.name}</h2>
      {podcast.subtitle && <p class="podcast__subtitle">{podcast.subtitle}</p>}
      <a class="podcast__follow" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3a.75.75 0 01-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.16a.75.75 0 11-.33-1.46c4.57-1.04 8.5-.59 11.66 1.34.35.22.46.68.25 1.03zm1.47-3.27a.94.94 0 01-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 11-.54-1.8c4.37-1.32 9.79-.68 13.5 1.6.44.27.58.85.3 1.29zm.13-3.4C15.33 8.3 8.9 8.08 5.2 9.2a1.12 1.12 0 11-.65-2.15c4.25-1.29 11.35-1.04 15.83 1.62a1.12 1.12 0 11-1.15 1.93z"/>
        </svg>
        Segui su Spotify
      </a>
    </header>

    {podcast.intro.length > 0 && (
      <div class="podcast__intro reveal">
        {podcast.intro.map((p) => <p>{p}</p>)}
      </div>
    )}

    {showGrid && (
      <ul class="podcast__grid" role="list">
        {episodes.map((ep) => (
          <li class="ep reveal">
            <a
              class="ep__media"
              href={ep.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ascolta su Spotify: ${ep.name}`}
            >
              {ep.image ? (
                <img class="ep__cover" src={ep.image} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="ep__cover ep__cover--ph" aria-hidden="true"></span>
              )}
              <span class="ep__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </a>
            <div class="ep__body">
              <h3 class="ep__title">{ep.name}</h3>
              <p class="ep__meta">
                {[formatDate(ep.releaseDate), formatDuration(ep.durationMs)].filter(Boolean).join(' · ')}
              </p>
            </div>
          </li>
        ))}
      </ul>
    )}

    {showPlayer && (
      <div class="podcast__player reveal">
        <iframe
          title={`Podcast ${podcast.name}`}
          src={`https://open.spotify.com/embed/show/${podcast.showId}?theme=0`}
          width="100%"
          height="600"
          style="border:0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    )}

    {noEpisodes && (
      <div class="podcast__empty reveal">
        <p class="podcast__empty-text">Tutti gli episodi sono su Spotify.</p>
        <a class="podcast__follow" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3a.75.75 0 01-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.16a.75.75 0 11-.33-1.46c4.57-1.04 8.5-.59 11.66 1.34.35.22.46.68.25 1.03zm1.47-3.27a.94.94 0 01-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 11-.54-1.8c4.37-1.32 9.79-.68 13.5 1.6.44.27.58.85.3 1.29zm.13-3.4C15.33 8.3 8.9 8.08 5.2 9.2a1.12 1.12 0 11-.65-2.15c4.25-1.29 11.35-1.04 15.83 1.62a1.12 1.12 0 11-1.15 1.93z"/>
          </svg>
          Ascolta tutti gli episodi
        </a>
        {diagMessage && <p class="podcast__diag" data-status={status}>⚠️ {diagMessage}</p>}
      </div>
    )}

    {contact.youtube && (
      <div class="podcast__yt reveal">
        <a class="podcast__follow podcast__follow--yt" href={contact.youtube} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
            <path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/>
          </svg>
          Guarda su YouTube
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .podcast {
    background: var(--bg);
    border-top: 1px solid rgba(63, 154, 166, 0.1);
  }

  .podcast__head {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto 3.5rem;
  }
  .podcast__title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .podcast__subtitle {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }
  .podcast__follow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    color: #000;
    background: #1ed760;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .podcast__follow:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(30, 215, 96, 0.25);
  }
  .podcast__follow--yt {
    color: #fff;
    background: #ff0000;
  }
  .podcast__follow--yt:hover {
    box-shadow: 0 10px 30px rgba(255, 0, 0, 0.3);
  }

  /* Testo introduttivo (incipit della bio) */
  .podcast__intro {
    max-width: 44rem;
    margin: 0 auto clamp(2.5rem, 6vw, 3.5rem);
    text-align: center;
  }
  .podcast__intro p {
    color: var(--text-muted);
    font-size: clamp(1.05rem, 2.3vw, 1.25rem);
    line-height: 1.75;
    margin-bottom: 1.1rem;
    font-style: italic;
  }
  .podcast__intro p:first-child::first-letter {
    font-family: var(--font-display);
    font-size: 3.2em;
    float: left;
    line-height: 0.8;
    padding: 0.06em 0.12em 0 0;
    color: var(--ember);
    font-style: normal;
  }

  /* Bottone YouTube sotto il player */
  .podcast__yt {
    text-align: center;
    margin-top: clamp(1.5rem, 4vw, 2.2rem);
  }

  /* Stato vuoto (nessuna lista episodi disponibile) */
  .podcast__empty {
    text-align: center;
    padding: clamp(2rem, 6vw, 3.5rem) 1rem;
    border: 1px dashed rgba(211, 154, 58, 0.25);
    border-radius: var(--radius);
    background: rgba(211, 154, 58, 0.04);
  }
  .podcast__empty-text {
    color: var(--text-muted);
    margin-bottom: 1.2rem;
    font-style: italic;
  }
  .podcast__empty .podcast__follow { margin-top: 0; }
  .podcast__empty .podcast__diag { margin-top: 1.4rem; }

  /* Griglia responsive (1 col mobile -> auto) */
  .podcast__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  @media (max-width: 560px) {
    .podcast__grid { grid-template-columns: 1fr; }
  }

  .ep {
    background: var(--surface);
    border: 1px solid rgba(63, 154, 166, 0.12);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .ep:hover {
    transform: translateY(-4px);
    border-color: var(--teal-bright);
    box-shadow: var(--glow);
  }

  .ep__media {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--teal);
    aspect-ratio: 1 / 1;
    cursor: pointer;
    overflow: hidden;
  }
  .ep__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease), filter 0.3s var(--ease);
  }
  .ep__cover--ph {
    background: radial-gradient(circle at 30% 30%, var(--teal-glow), var(--teal) 70%);
  }
  .ep__media:hover .ep__cover { transform: scale(1.05); filter: brightness(1.05); }

  .ep__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #000;
    background: rgba(63, 154, 166, 0.95);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.3s var(--ease);
  }
  .ep__media:hover .ep__play,
  .ep__media:focus-visible .ep__play { transform: scale(1.12); }

  .ep__body { padding: 1rem 1.1rem 1.2rem; }
  .ep__title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.3;
    /* max 2 righe */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ep__meta { margin-top: 0.4rem; color: var(--text-dim); font-size: 0.85rem; }

  .ep__frame { padding: 0.8rem; }

  .podcast__player {
    max-width: 760px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .podcast__diag {
    margin-top: 1.25rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 60ch;
    margin-inline: auto;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(63, 154, 166, 0.25);
    border-radius: var(--radius-sm);
    background: rgba(63, 154, 166, 0.06);
  }
</style>
