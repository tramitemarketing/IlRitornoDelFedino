---
import { siteConfig } from '../site.config';
const { podcast } = siteConfig;
const hasShow = podcast.showId.trim() !== '';
const hasEpisodes = podcast.episodes.length > 0;
---

<section class="podcast section" id="podcast">
  <div class="container">
    <div class="podcast__head reveal">
      <p class="eyebrow">Podcast</p>
      <h2 class="podcast__title">{podcast.name}</h2>
      <p class="podcast__subtitle">{podcast.subtitle}</p>
      <a class="podcast__follow" href={podcast.spotifyUrl} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.5 17.3a.75.75 0 01-1.03.25c-2.82-1.72-6.37-2.11-10.55-1.16a.75.75 0 11-.33-1.46c4.57-1.04 8.5-.59 11.66 1.34.35.22.46.68.25 1.03zm1.47-3.27a.94.94 0 01-1.29.31c-3.23-1.98-8.15-2.56-11.97-1.4a.94.94 0 11-.54-1.8c4.37-1.32 9.79-.68 13.5 1.6.44.27.58.85.3 1.29zm.13-3.4C15.33 8.3 8.9 8.08 5.2 9.2a1.12 1.12 0 11-.65-2.15c4.25-1.29 11.35-1.04 15.83 1.62a1.12 1.12 0 11-1.15 1.93z"/>
        </svg>
        Segui su Spotify
      </a>
    </div>

    {hasShow && (
      <div class="podcast__player reveal">
        <iframe
          title={`Podcast ${podcast.name}`}
          src={`https://open.spotify.com/embed/show/${podcast.showId}?theme=0`}
          width="100%"
          height="352"
          frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      </div>
    )}

    {hasEpisodes && (
      <div class="podcast__grid">
        {podcast.episodes.map((ep) => (
          <article class="podcast__card reveal">
            {ep.title && <h3 class="podcast__card-title">{ep.title}</h3>}
            <iframe
              title={ep.title ?? 'Episodio'}
              src={`https://open.spotify.com/embed/episode/${ep.id}?theme=0`}
              width="100%"
              height="152"
              frameborder="0"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
            ></iframe>
          </article>
        ))}
      </div>
    )}

    {!hasShow && !hasEpisodes && (
      <div class="podcast__empty reveal">
        <p>🎙️ Gli episodi appariranno qui.</p>
        <p class="podcast__empty-hint">
          Aggiungi lo <code>showId</code> o gli <code>episodes</code> in
          <code>src/site.config.ts</code>.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .podcast {
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(0, 224, 198, 0.07), transparent 60%),
      var(--bg-soft);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .podcast__head {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto 3rem;
  }
  .podcast__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .podcast__subtitle {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }
  .podcast__follow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    color: #07080d;
    background: #1ed760;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .podcast__follow:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(30, 215, 96, 0.3);
  }

  .podcast__player {
    max-width: 760px;
    margin: 0 auto;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  .podcast__grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .podcast__card {
    background: var(--surface);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius);
    padding: 1.25rem;
    transition: transform 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .podcast__card:hover {
    transform: translateY(-4px);
    border-color: rgba(108, 92, 231, 0.4);
  }
  .podcast__card-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .podcast__card iframe { border-radius: var(--radius-sm); }

  .podcast__empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    max-width: 560px;
    margin: 0 auto;
  }
  .podcast__empty-hint { font-size: 0.9rem; color: var(--text-dim); margin-top: 0.5rem; }
  .podcast__empty code {
    background: rgba(255, 255, 255, 0.07);
    padding: 0.15em 0.4em;
    border-radius: 6px;
    font-size: 0.85em;
  }
</style>
