# Credenziali Spotify per il recupero automatico degli episodi.
# Crea un'app gratuita su https://developer.spotify.com/dashboard
# poi copia questo file in ".env" e incolla i valori.
#
# Su Netlify/Vercel: NON committare .env, aggiungi queste variabili
# nelle "Environment Variables" del progetto.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Token utente per leggere la lista episodi dei PODCAST (Spotify blocca i
# podcast col solo Client Credentials -> 403). Ottienilo una volta con:
#   npm run spotify:auth
# poi incollalo qui e nelle Environment Variables di Vercel/Netlify.
SPOTIFY_REFRESH_TOKEN=
